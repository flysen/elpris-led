#define FW_VERSION "dev"   // local builds never auto-update
#endif

// ---------- HARDWARE ----------
// DATA_PIN is set per board in platform.h
#define MAX_LEDS     300       // upper limit, the actual count is set in the web UI
#define LED_TYPE     WS2812B
#define COLOR_ORDER  GRB

// ---------- CONSTANTS ----------
// SLOT_SEC and the backoff times are in elpris_logic.h
const char* NTP_SERVER = "pool.ntp.org";
const char* DEFAULT_TZ = "CET-1CEST,M3.5.0,M10.5.0/3";   // Sweden
const char* MDNS_NAME  = "elpris-led";                   // reachable as http://elpris-led.local

const int SLOTS_PER_DAY   = 96;
const int RING_SIZE       = 512;      // cache for about 5 days of 15-minute slots

const int TOMORROW_FETCH_MIN = 13 * 60 + 30;  // start looking for tomorrow's prices at 13:30 local time
const int TOMORROW_ERROR_MIN = 16 * 60;       // missing tomorrow prices count as an error only after 16:00
const int STATUS_LEDS        = 3;             // number of LEDs that blink magenta on fetch errors

const unsigned long NOT_PUBLISHED_RETRY_MS  = 15UL * 60UL * 1000UL;

// Our own fetch error codes. HTTPClient uses -1 to -11, so these start at -100.
const int FETCH_ERR_BEGIN = -100;   // could not start the request
const int FETCH_ERR_PARSE = -101;   // the response could not be read as price data
const int FETCH_ERR_EMPTY = -102;   // the response had no prices

// ---------- UPDATES ----------
// The install page (GitHub Pages) publishes manifest.json with the latest version and one app binary per board.
const char* UPDATE_BASE_URL = "https://flysen.github.io/elpris-led/";
const char* UPDATE_FIRMWARE = "firmware/" BOARD_NAME "/elpris-led.bin";
const unsigned long UPDATE_FIRST_CHECK_MS = 2UL * 60UL * 1000UL;          // first check 2 min after boot
const unsigned long UPDATE_INTERVAL_MS    = 24UL * 60UL * 60UL * 1000UL;  // then once a day
const unsigned long UPDATE_RETRY_MS       = 60UL * 60UL * 1000UL;         // retry after 1 h if the check fails

// ---------- LED DATA ----------
CRGB leds[MAX_LEDS];
CRGB ledColor[MAX_LEDS];
int  winStartSlot = 0;     // first slot in the display window (local midnight today)
int  winSlots     = SLOTS_PER_DAY;   // one or two days, counted from real midnights (DST-safe)

// ---------- PRICE CACHE (ring buffer, key = absolute 15-minute slot since epoch) ----------
int32_t slotId[RING_SIZE];
float   slotPrice[RING_SIZE];

inline bool  hasSlot(int32_t s)   { return s >= 0 && slotId[s % RING_SIZE] == s; }
inline float getSlot(int32_t s)   { return slotPrice[s % RING_SIZE]; }
inline void  putSlot(int32_t s, float p) { slotId[s % RING_SIZE] = s; slotPrice[s % RING_SIZE] = p; }
void clearCache() { for (int i = 0; i < RING_SIZE; i++) slotId[i] = -1; }

