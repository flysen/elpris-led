// =====================================================================
//  Settings: load / validate / save
// =====================================================================
void sanitizeSettings() {
  for (int i = 0; cfgArea[i]; i++) cfgArea[i] = toupper(cfgArea[i]);
  if (!validArea(cfgArea)) strcpy(cfgArea, "SE3");

  cfgNightStart  = constrain(cfgNightStart, 0, 23);
  cfgNightEnd    = constrain(cfgNightEnd, 0, 23);
  cfgBrightDay   = constrain(cfgBrightDay, 1, 255);
  cfgBrightNight = constrain(cfgBrightNight, 0, 255);
  cfgNumLeds     = constrain(cfgNumLeds, 1, MAX_LEDS);

  if (strlen(cfgTz) < 3) strlcpy(cfgTz, DEFAULT_TZ, sizeof(cfgTz));
  if (strlen(cfgApPw) > 0 && strlen(cfgApPw) < 8) cfgApPw[0] = '\0';   // WPA2 requires at least 8 characters
}

void loadSettings() {
  String a = preferences.getString("area", "SE3");
  a.toCharArray(cfgArea, sizeof(cfgArea));
  String z = preferences.getString("tz", DEFAULT_TZ);
  z.toCharArray(cfgTz, sizeof(cfgTz));
  cfgNightStart  = preferences.getInt("nstart", 23);
  cfgNightEnd    = preferences.getInt("nend", 6);
  cfgBrightDay   = preferences.getInt("bday", 40);
  cfgBrightNight = preferences.getInt("bnight", 5);
  cfgNumLeds     = preferences.getInt("leds", 100);
  cfgAutoUpdate  = preferences.getBool("autoupd", true);
  preferences.getString("otapw", "").toCharArray(cfgOtaPw, sizeof(cfgOtaPw));
  preferences.getString("appw", "").toCharArray(cfgApPw, sizeof(cfgApPw));
  sanitizeSettings();
}

void saveSettings() {
  preferences.putString("area", cfgArea);
  preferences.putString("tz", cfgTz);
  preferences.putInt("nstart", cfgNightStart);
  preferences.putInt("nend", cfgNightEnd);
  preferences.putInt("bday", cfgBrightDay);
  preferences.putInt("bnight", cfgBrightNight);
  preferences.putInt("leds", cfgNumLeds);
  preferences.putBool("autoupd", cfgAutoUpdate);
  preferences.putString("otapw", cfgOtaPw);
  preferences.putString("appw", cfgApPw);
}

void applyTimezone() {
  setenv("TZ", cfgTz, 1);
  tzset();
}

// =====================================================================
//  Time helpers (daysFromCivil, parseIso and localMidnightSlot are in elpris_logic.h)
// =====================================================================
bool dayCovered(int32_t startSlot) {
  return hasSlot(startSlot + 2) && hasSlot(startSlot + 50) && hasSlot(startSlot + 90);
}

String priceUrl(time_t now, int dayOffset) {
  struct tm t;
  localtime_r(&now, &t);
  t.tm_mday += dayOffset;
  t.tm_isdst = -1;
  mktime(&t);
  char buf[16];
  strftime(buf, sizeof(buf), "%Y/%m-%d", &t);
  return String("https://www.elprisetjustnu.se/api/v1/prices/") + buf + "_" + cfgArea + ".json";
}

// =====================================================================
//  Fetching prices
// =====================================================================
String describeFetchError(int code) {
  if (code > 0)               return "server answered HTTP " + String(code);
  if (code == FETCH_ERR_BEGIN) return "could not start the request";
  if (code == FETCH_ERR_PARSE) return "could not read the price data";
  if (code == FETCH_ERR_EMPTY) return "no prices in the response";
  return HTTPClient::errorToString(code);   // connection, TLS and timeout errors
}

bool fetchDay(const String& url, int& code) {
  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  setHttpTimeouts(http);
  http.useHTTP10(true);
  if (!http.begin(client, url)) { code = FETCH_ERR_BEGIN; return false; }

  code = http.GET();
  if (code != HTTP_CODE_OK) { http.end(); return false; }

  // The response is a JSON array with one object per price. Reading the objects one at a time,
  // instead of the whole array at once, keeps memory use small enough for ESP8266.
  JsonDocument filter;
  filter["SEK_per_kWh"] = true;
  filter["time_start"]  = true;
  filter["time_end"]    = true;

  Stream& stream = http.getStream();
  int stored = 0;
  bool parseError = !stream.find("[");
  if (!parseError) {
    do {
      JsonDocument item;
      DeserializationError err = deserializeJson(item, stream, DeserializationOption::Filter(filter));
      if (err) { parseError = true; break; }

      const char* ts = item["time_start"];
      const char* te = item["time_end"];
      if (!ts) continue;
      time_t a, b;
      if (!parseIso(ts, a)) continue;
      if (!te || !parseIso(te, b)) b = a;   // priceSlots then assumes one hour
      float p = item["SEK_per_kWh"] | 0.0f;
      int32_t s0, s1;
      priceSlots(a, b, s0, s1);
      for (int32_t s = s0; s < s1; s++) { putSlot(s, p); stored++; }
    } while (stream.findUntil(",", "]"));
  }
  http.end();

  if (stored == 0) { code = parseError ? FETCH_ERR_PARSE : FETCH_ERR_EMPTY; return false; }
  return true;
}

void serviceFetch(const struct tm& t, time_t now) {
  if ((long)(millis() - nextAttemptMs) < 0) return;

  int32_t todaySlot    = localMidnightSlot(now, 0);
  int32_t tomorrowSlot = localMidnightSlot(now, 1);
  int minutes = t.tm_hour * 60 + t.tm_min;

  int dayOffset;
  if (!dayCovered(todaySlot)) dayOffset = 0;
  else if (minutes >= TOMORROW_FETCH_MIN && !dayCovered(tomorrowSlot)) dayOffset = 1;
  else return;

  uint32_t freeBefore = ESP.getFreeHeap();
  uint32_t blockBefore = maxFreeBlock();
  int code = 0;
  bool ok = fetchDay(priceUrl(now, dayOffset), code);
  unsigned long ms = millis();

  if (ok) {
    failStreak = 0;
    fetchFailing = false;
    lastFetchError = "";
    needRebuild = true;
    int32_t startSlot = dayOffset ? tomorrowSlot : todaySlot;
    nextAttemptMs = ms + (dayCovered(startSlot) ? 1000UL : NOT_PUBLISHED_RETRY_MS);
    Serial.printf("Prices fetched (day +%d)\n", dayOffset);
  } else if (dayOffset == 1 && code == 404) {
    nextAttemptMs = ms + NOT_PUBLISHED_RETRY_MS;
    fetchFailing = (minutes >= TOMORROW_ERROR_MIN);
    if (fetchFailing) lastFetchError = "tomorrow's prices are not published yet";
    Serial.println("Tomorrow's prices not published yet");
  } else {
    failStreak++;
    unsigned long d = backoffMs(failStreak);
    nextAttemptMs = ms + d;
    fetchFailing = (dayOffset == 0) || (minutes >= TOMORROW_ERROR_MIN);
    lastFetchError = describeFetchError(code) + " (code " + String(code) + ", free memory " +
                     String(freeBefore) + " bytes, largest block " + String(blockBefore) + " bytes)";
    Serial.printf("Fetch failed: %s, retrying in %lu s\n", lastFetchError.c_str(), d / 1000);
  }
}

// =====================================================================
//  Automatic updates from GitHub releases
// =====================================================================
bool fetchLatestVersion(String& out) {
  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  setHttpTimeouts(http);
  http.useHTTP10(true);
  if (!http.begin(client, String(UPDATE_BASE_URL) + "manifest.json")) return false;

  int code = http.GET();
  if (code != HTTP_CODE_OK) { http.end(); return false; }

  JsonDocument filter;
  filter["version"] = true;
  JsonDocument doc;
  DeserializationError err = deserializeJson(doc, http.getStream(), DeserializationOption::Filter(filter));
  http.end();
  if (err) return false;

  const char* v = doc["version"];
  if (!v) return false;
  out = v;
  return true;
}

void installUpdate() {
  Serial.printf("Installing update %s (running %s on %s)\n", latestVersion.c_str(), FW_VERSION, BOARD_NAME);
  fill_solid(leds, cfgNumLeds, CRGB::Black);
  for (int i = 0; i < cfgNumLeds; i += 4) leds[i] = CRGB(0, 40, 40);   // dim cyan dots while updating
  FastLED.show();

  WiFiClientSecure client;
  client.setInsecure();
  httpUpdate.rebootOnUpdate(true);
  t_httpUpdate_return r = httpUpdate.update(client, String(UPDATE_BASE_URL) + UPDATE_FIRMWARE);

  // Only reached if the update did not reboot the device
  if (r == HTTP_UPDATE_FAILED) {
    updateMessage = "Update failed: " + httpUpdate.getLastErrorString();
  } else {
    updateMessage = "No update installed";
  }
  Serial.println(updateMessage);
  needRebuild = true;
}

void serviceUpdate() {
  if (!updateRequested && (long)(millis() - nextUpdateCheckMs) < 0) return;
  if (WiFi.status() != WL_CONNECTED) return;

  bool manual = updateRequested;
  updateRequested = false;

  String v;
  if (!fetchLatestVersion(v)) {
    nextUpdateCheckMs = millis() + UPDATE_RETRY_MS;
    if (manual) updateMessage = "Could not check for updates";
    Serial.println("Update check failed");
    return;
  }
  nextUpdateCheckMs = millis() + UPDATE_INTERVAL_MS;
  latestVersion = v;

  if (isNewerVersion(v.c_str(), FW_VERSION)) {
    if (cfgAutoUpdate || manual) installUpdate();
    else updateMessage = "Update available";
  } else if (manual) {
    updateMessage = "Already up to date";
  }
}

// =====================================================================
//  Build the colors for the strip
// =====================================================================
inline void ledRange(int i, int& s0, int& s1) {
  ledSlotRange(i, winSlots, cfgNumLeds, s0, s1);
}

void rebuildTimeline(time_t now) {
  // The window is counted from real midnights so 23- and 25-hour days (DST) come out right
  winStartSlot = localMidnightSlot(now, 0);
  int32_t tomorrowStart = localMidnightSlot(now, 1);
  int32_t dayAfterStart = localMidnightSlot(now, 2);
  bool tomorrow = dayCovered(tomorrowStart);
  winSlots = (tomorrow ? dayAfterStart : tomorrowStart) - winStartSlot;

  float mn = 1e9f, mx = -1e9f;
  for (int s = 0; s < winSlots; s++) {
    if (!hasSlot(winStartSlot + s)) continue;
    float p = getSlot(winStartSlot + s);
    if (p < mn) mn = p;
    if (p > mx) mx = p;
  }

  CRGB prev = CRGB::Black;
  for (int i = 0; i < cfgNumLeds; i++) {
    int s0, s1;
    ledRange(i, s0, s1);
    float sum = 0; int cnt = 0;
    for (int s = s0; s < s1; s++) {
      if (hasSlot(winStartSlot + s)) { sum += getSlot(winStartSlot + s); cnt++; }
    }
    if (cnt == 0) {
      ledColor[i] = prev;
    } else {
      float p = sum / cnt;
      float ratio = (mx > mn) ? (p - mn) / (mx - mn) : 0.5f;
      uint8_t hue = (uint8_t)((1.0f - ratio) * 96);
      ledColor[i] = CHSV(hue, 255, 255);
    }
    prev = ledColor[i];
  }
}

// =====================================================================
//  Web interface
// =====================================================================
String htmlEscape(const String& s) {
  String o;
  for (unsigned i = 0; i < s.length(); i++) {
    char c = s[i];
    switch (c) {
      case '&':  o += "&amp;";  break;
      case '<':  o += "&lt;";   break;
      case '>':  o += "&gt;";   break;
      case '"':  o += "&quot;"; break;
      case '\'': o += "&#39;";  break;
      default:   o += c;
    }
  }
  return o;
}

